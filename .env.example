# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Domaine ---
DOMAIN=http://localhost:3000
NODE_ENV=development

# --- Produit ---
PRODUCT_NAME=...
PRODUCT_DESCRIPTION=...
PRODUCT_PRICE_CENTS=0
CURRENCY=eur
# Lien envoyé au client par email après achat (Google Drive, Notion, plateforme de cours...)
PRODUCT_DELIVERY_URL=...

# --- Email (SMTP pour le reçu automatique + le code de connexion admin) ---
SMTP_HOST=...
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
FROM_EMAIL=...

# --- Stockage des images uploadées (compte gratuit sur cloudinary.com) ---
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# --- Connexion admin ---
ADMIN_USERNAME=...
# Ne jamais mettre un mot de passe en clair ici : génère un hash avec `npm run hash-password -- "tonMotDePasse"`
ADMIN_PASSWORD_HASH=...
# Adresse email qui recevra le code de vérification à 6 chiffres
ADMIN_EMAIL=...
# Chaîne aléatoire longue et secrète pour signer les sessions (ne jamais partager) — génère-la avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=...
